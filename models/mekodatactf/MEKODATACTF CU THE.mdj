                  },
                  "points": "901:770;1500:770",
                  "nameLabel": {
                    "$ref": "ac7bb18a45394d2ca03ef825c87eb6cf"
                  },
                  "stereotypeLabel": {
                    "$ref": "2ade04f1a71d4eb5bf382b32c0d64db3"
                  },
                  "propertyLabel": {
                    "$ref": "19a82749211647bcbf05eeaec76baf30"
