<section class="section">
  <div class="container narrow">
    <a href="/admin/teams" class="muted"><%= t('admin.back') %></a>
    <div class="card">
      <div class="card-head">
        <div>
          <p class="section-kicker mono"><%= t('admin.teamDetail') %></p>
          <h1><%= team.name %></h1>
        </div>
        <form action="/admin/teams/<%= team.id %>/delete" method="post" data-confirm="<%= t('admin.confirmDelete') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-danger"><%= t('admin.delete') %></button>
        </form>
      </div>
      <dl class="details">
        <dt><%= t('team.email') %></dt><dd><%= team.email %></dd>
        <dt><%= t('team.school') %></dt><dd><%= team.school || '—' %></dd>
        <dt><%= t('team.phone') %></dt><dd><%= team.phone || '—' %></dd>
        <dt><%= t('team.registeredAt') %></dt><dd class="mono"><%= team.created_at %> UTC</dd>
      </dl>
      <h2 class="form-section-title"><%= t('team.members') %> (<%= team.members.length %>)</h2>
      <%- include('../partials/members-table', { members: team.members }) %>
    </div>
  </div>
</section>
