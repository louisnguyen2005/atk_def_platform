<div class="a-grid a-grid-stats">
  <div class="a-stat">
    <span class="a-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5a5.5 5.5 0 0 1 11 0"/><circle cx="9.5" cy="8" r="3.3"/><path d="M16.5 5.7a3.3 3.3 0 0 1 0 6.1M20.5 19.5a5.6 5.6 0 0 0-2.4-4.5"/></svg></span>
    <span class="a-stat-value"><%= stats.teams %></span>
    <span class="a-stat-label"><%= t('admin.totalTeams') %></span>
  </div>
  <div class="a-stat a-stat--gold">
    <span class="a-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.6"/><path d="M5 20a7 7 0 0 1 14 0"/></svg></span>
    <span class="a-stat-value"><%= stats.members %></span>
    <span class="a-stat-label"><%= t('admin.totalMembers') %></span>
  </div>
  <div class="a-stat a-stat--muted">
    <span class="a-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2.5"/><path d="M3.5 9.5h17M7 14h4"/></svg></span>
    <span class="a-stat-value"><%= stats.accounts %></span>
    <span class="a-stat-label"><%= t('admin.totalAccounts') %></span>
  </div>
  <div class="a-stat <%= registrationOpen ? 'a-stat--ok' : '' %>">
    <span class="a-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><% if (registrationOpen) { %><path d="M7 11V8a5 5 0 0 1 10 0v3"/><rect x="5" y="11" width="14" height="9" rx="2"/><% } else { %><path d="M8 11V8a4 4 0 0 1 8 0v3"/><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M12 15v2"/><% } %></svg></span>
    <span class="a-stat-pill"><span class="a-pill <%= registrationOpen ? 'a-pill-ok' : 'a-pill-off' %>"><%= registrationOpen ? t('home.registrationOpen') : t('home.registrationClosed') %></span></span>
    <span class="a-stat-label"><%= t('admin.registrationStatus') %></span>
  </div>
</div>

<div class="a-grid a-grid-2">
  <section class="a-card">
    <div class="a-card-head">
      <div>
        <h2><%= t('admin.schedule') %></h2>
        <p><%= t('admin.memberRange').replace('{min}', settings.min_members).replace('{max}', settings.max_members) %></p>
      </div>
      <a href="/admin/schedule" class="a-btn a-btn-soft a-btn-sm">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17z"/></svg>
        <%= t('team.edit') %>
      </a>
    </div>
    <div class="a-card-body">
      <dl class="a-list">
        <div><dt><%= t('admin.registrationDeadline') %></dt><dd class="a-mono"><%= formatDateTime(settings.registration_deadline, lang) %></dd></div>
        <div><dt><%= t('admin.contestStart') %></dt><dd class="a-mono"><%= formatDateTime(settings.contest_start, lang) %></dd></div>
        <div><dt><%= t('admin.contestEnd') %></dt><dd class="a-mono"><%= formatDateTime(settings.contest_end, lang) %></dd></div>
        <div><dt><%= t('admin.location') %></dt><dd><%= settings.event_location %></dd></div>
      </dl>
    </div>
  </section>

  <section class="a-card">
    <div class="a-card-head">
      <div>
        <h2><%= t('admin.exportData') %></h2>
        <p><%= t('admin.exportHint') %></p>
      </div>
    </div>
    <div class="a-card-body">
      <div class="a-actions">
        <a href="/admin/export.xlsx" class="a-btn a-btn-primary">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M8 11l4 4 4-4"/><path d="M5 19h14"/></svg>
          <%= t('admin.exportXlsx') %>
        </a>
        <a href="/admin/export.csv" class="a-btn a-btn-soft">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M8 11l4 4 4-4"/><path d="M5 19h14"/></svg>
          <%= t('admin.exportCsv') %>
        </a>
      </div>
    </div>
  </section>
</div>

<section class="a-card">
  <div class="a-card-head">
    <div><h2><%= t('admin.recentTeams') %></h2></div>
    <a href="/admin/teams" class="a-btn a-btn-ghost a-btn-sm">
      <%= t('admin.viewAll') %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </a>
  </div>
  <% if (recentTeams.length) { %>
    <ul class="a-rows">
      <% recentTeams.forEach(function (tm) { %>
        <li>
          <a href="/admin/teams/<%= tm.id %>">
            <span class="a-ini" aria-hidden="true"><%= tm.name.trim().charAt(0).toUpperCase() %></span>
            <span class="a-row-main">
              <b><%= tm.name %></b>
              <span><%= tm.email %><%= tm.school ? ' · ' + tm.school : '' %></span>
            </span>
            <span class="a-count"><%= tm.member_count %> <%= t('admin.teamMembers').toLowerCase() %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="a-empty"><%= t('admin.noTeams') %></p>
  <% } %>
</section>
