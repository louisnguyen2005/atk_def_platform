<%- include('../partials/errors') %>

<form action="/admin/schedule" method="post" class="a-card a-form a-form-narrow">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <fieldset class="a-fieldset">
    <legend class="a-legend"><%= t('admin.registrationStatus') %></legend>
    <label class="a-switch">
      <input type="checkbox" name="registration_open" value="1" <%= settings.registration_open === '1' ? 'checked' : '' %>>
      <span class="a-switch-track" aria-hidden="true"></span>
      <span class="a-switch-text">
        <b><%= t('admin.registrationOpen') %></b>
        <small><%= t('admin.registrationOpenHint') %></small>
      </span>
    </label>
  </fieldset>

  <fieldset class="a-fieldset">
    <legend class="a-legend"><%= t('admin.scheduleGroupTime') %></legend>
    <div class="a-fields">
      <label class="a-field-block">
        <span><%= t('admin.registrationDeadline') %></span>
        <input type="datetime-local" name="registration_deadline" value="<%= settings.registration_deadline %>" required>
      </label>
      <span></span>
      <label class="a-field-block">
        <span><%= t('admin.contestStart') %></span>
        <input type="datetime-local" name="contest_start" value="<%= settings.contest_start %>" required>
      </label>
      <label class="a-field-block">
        <span><%= t('admin.contestEnd') %></span>
        <input type="datetime-local" name="contest_end" value="<%= settings.contest_end %>" required>
      </label>
    </div>
  </fieldset>

  <fieldset class="a-fieldset">
    <legend class="a-legend"><%= t('admin.scheduleGroupTeam') %></legend>
    <div class="a-fields">
      <label class="a-field-block">
        <span><%= t('admin.minMembers') %></span>
        <input type="number" name="min_members" value="<%= settings.min_members %>" min="1" max="<%= settings.max_members %>" required>
      </label>
      <label class="a-field-block">
        <span><%= t('admin.maxMembers') %></span>
        <input type="number" value="<%= settings.max_members %>" disabled>
        <small><%= t('admin.maxMembersFixed') %></small>
      </label>
    </div>
  </fieldset>

  <fieldset class="a-fieldset">
    <legend class="a-legend"><%= t('admin.scheduleGroupEvent') %></legend>
    <div class="a-fields a-fields-1">
      <label class="a-field-block">
        <span><%= t('admin.location') %></span>
        <input type="text" name="event_location" value="<%= settings.event_location %>" maxlength="200">
      </label>
    </div>
  </fieldset>

  <div class="a-card-foot">
    <p class="a-hint"><%= t('admin.contentsHint2') %></p>
    <button type="submit" class="a-btn a-btn-primary">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
      <%= t('admin.save') %>
    </button>
  </div>
</form>
