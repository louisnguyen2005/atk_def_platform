<section class="section">
  <div class="container">
    <h1><%= t('admin.title') %></h1>
    <%- include('../partials/admin-nav') %>

    <div class="card narrow-card">
      <%- include('../partials/errors') %>
      <form action="/admin/schedule" method="post" class="form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <label class="switch">
          <input type="checkbox" name="registration_open" value="1" <%= settings.registration_open === '1' ? 'checked' : '' %>>
          <span><%= t('admin.registrationOpen') %></span>
        </label>

        <div class="grid-2">
          <label>
            <span><%= t('admin.registrationDeadline') %></span>
            <input type="datetime-local" name="registration_deadline" value="<%= settings.registration_deadline %>" required>
          </label>
          <span></span>
          <label>
            <span><%= t('admin.contestStart') %></span>
            <input type="datetime-local" name="contest_start" value="<%= settings.contest_start %>" required>
          </label>
          <label>
            <span><%= t('admin.contestEnd') %></span>
            <input type="datetime-local" name="contest_end" value="<%= settings.contest_end %>" required>
          </label>
          <label>
            <span><%= t('admin.minMembers') %></span>
            <input type="number" name="min_members" value="<%= settings.min_members %>" min="1" max="10" required>
          </label>
          <label>
            <span><%= t('admin.maxMembers') %></span>
            <input type="number" name="max_members" value="<%= settings.max_members %>" min="1" max="10" required>
          </label>
        </div>

        <label>
          <span><%= t('admin.location') %></span>
          <input type="text" name="event_location" value="<%= settings.event_location %>" maxlength="200">
        </label>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary"><%= t('admin.save') %></button>
        </div>
      </form>
    </div>
  </div>
</section>
