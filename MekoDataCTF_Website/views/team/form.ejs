<section class="section">
  <div class="container narrow">
    <div class="card">
      <h1><%= title %></h1>
      <%- include('../partials/errors') %>

      <form action="/team" method="post" class="form" data-team-form data-max="<%= maxMembers %>" data-min="<%= minMembers %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="grid-2">
          <label>
            <span><%= t('team.name') %> *</span>
            <input type="text" name="name" value="<%= data.name %>" required minlength="2" maxlength="50">
          </label>
          <label>
            <span><%= t('team.email') %></span>
            <input type="email" value="<%= user.email %>" disabled>
          </label>
          <label>
            <span><%= t('team.school') %></span>
            <input type="text" name="school" value="<%= data.school %>" maxlength="120">
          </label>
          <label>
            <span><%= t('team.phone') %></span>
            <input type="tel" name="phone" value="<%= data.phone %>" maxlength="20">
          </label>
        </div>

        <h2 class="form-section-title"><%= t('team.members') %></h2>
        <p class="muted"><%= t('team.membersHint', { min: minMembers, max: maxMembers }) %></p>

        <div class="members" data-members>
          <% data.members.forEach(function (m, i) { %>
            <fieldset class="member-row" data-member-row>
              <legend>
                <span data-member-label><%= t('team.member', { n: i + 1 }) %></span>
                <span class="badge badge-ok" data-leader-badge <%= i === 0 ? '' : 'hidden' %>><%= t('team.leader') %></span>
              </legend>
              <label>
                <span><%= t('team.fullName') %> *</span>
                <input type="text" name="members[<%= i %>][full_name]" value="<%= m.full_name %>" required maxlength="80">
              </label>
              <label>
                <span><%= t('team.studentId') %> *</span>
                <input type="text" name="members[<%= i %>][student_id]" value="<%= m.student_id %>" required pattern="[A-Za-z0-9]{4,15}" maxlength="15" class="mono">
              </label>
              <button type="button" class="btn btn-ghost btn-sm" data-remove-member><%= t('team.removeMember') %></button>
            </fieldset>
          <% }) %>
        </div>

        <template data-member-template>
          <fieldset class="member-row" data-member-row>
            <legend>
              <span data-member-label></span>
              <span class="badge badge-ok" data-leader-badge hidden><%= t('team.leader') %></span>
            </legend>
            <label>
              <span><%= t('team.fullName') %> *</span>
              <input type="text" data-field="full_name" required maxlength="80">
            </label>
            <label>
              <span><%= t('team.studentId') %> *</span>
              <input type="text" data-field="student_id" required pattern="[A-Za-z0-9]{4,15}" maxlength="15" class="mono">
            </label>
            <button type="button" class="btn btn-ghost btn-sm" data-remove-member><%= t('team.removeMember') %></button>
          </fieldset>
        </template>

        <button type="button" class="btn btn-outline" data-add-member data-label="<%= t('team.member', { n: '{n}' }) %>"><%= t('team.addMember') %></button>

        <div class="form-actions">
          <% if (team) { %><a href="/team" class="btn btn-ghost"><%= t('team.cancel') %></a><% } %>
          <button type="submit" class="btn btn-primary"><%= t('team.save') %></button>
        </div>
      </form>
    </div>
  </div>
</section>
