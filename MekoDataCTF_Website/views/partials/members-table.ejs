<div class="table-wrap">
  <table class="table">
    <thead>
      <tr><th>#</th><th><%= t('team.fullName') %></th><th><%= t('team.studentId') %></th><th></th></tr>
    </thead>
    <tbody>
      <% members.forEach(function (m, i) { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= m.full_name %></td>
          <td class="mono"><%= m.student_id %></td>
          <td><% if (m.is_leader) { %><span class="badge badge-ok"><%= t('team.leader') %></span><% } %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
