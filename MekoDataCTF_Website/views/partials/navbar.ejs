<header class="navbar">
  <div class="container nav-inner">
    <a href="/" class="brand">
      <img src="/images/favicon.svg" alt="" width="32" height="32">
      <span class="brand-text">Meko<span>Data</span>CTF</span>
    </a>

    <nav class="nav-links">
      <a href="/scoreboard">Scoreboard</a>
      <a href="/#about"><%= t('nav.about') %></a>
      <a href="/#schedule"><%= t('nav.schedule') %></a>
      <a href="/#rules"><%= t('nav.rules') %></a>
      <a href="/#prizes"><%= t('nav.prizes') %></a>
      <a href="/#faq"><%= t('nav.faq') %></a>

      <% if (user) { %>
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="<%= currentPath.startsWith('/admin') ? 'active' : '' %>"><%= t('nav.admin') %></a>
        <% } else { %>
          <a href="/team" class="<%= currentPath.startsWith('/team') ? 'active' : '' %>"><%= t('nav.myTeam') %></a>
        <% } %>
        <form action="/logout" method="post" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-ghost btn-sm"><%= t('nav.logout') %></button>
        </form>
      <% } else if (memberTeam) { %>
        <a href="/team" class="<%= currentPath.startsWith('/team') ? 'active' : '' %>" title="<%= memberTeam.name %>"><%= t('nav.myTeam') %></a>
        <form action="/logout" method="post" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-ghost btn-sm"><%= t('nav.logout') %></button>
        </form>
      <% } else { %>
        <a href="/login"><%= t('nav.login') %></a>
        <a href="/register" class="btn btn-primary btn-sm"><%= t('nav.register') %></a>
      <% } %>

      <div class="lang-switch" role="group" aria-label="Language">
        <a href="<%= langUrl('vi') %>" class="<%= lang === 'vi' ? 'active' : '' %>">VI</a>
        <a href="<%= langUrl('en') %>" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
      </div>
    </nav>
  </div>
</header>
