<section class="section">
  <div class="container auth-wrap">
    <div class="card auth-card">
      <h1><%= t('auth.registerTitle') %></h1>
      <p class="muted"><%= t('auth.registerHint') %></p>
      <%- include('../partials/errors') %>

      <% if (!registrationOpen) { %>
        <div class="alert alert-warning"><%= t('auth.registrationClosed') %></div>
      <% } else { %>
        <form action="/register" method="post" class="form" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>
            <span><%= t('auth.email') %></span>
            <input type="email" name="email" value="<%= email %>" required autocomplete="email" autofocus>
          </label>
          <label>
            <span><%= t('auth.password') %></span>
            <input type="password" name="password" required minlength="8" autocomplete="new-password">
          </label>
          <label>
            <span><%= t('auth.confirmPassword') %></span>
            <input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password">
          </label>
          <button type="submit" class="btn btn-primary btn-block"><%= t('auth.submitRegister') %></button>
        </form>
      <% } %>
      <p class="muted center"><%= t('auth.haveAccount') %> <a href="/login"><%= t('nav.login') %></a></p>
    </div>
  </div>
</section>
