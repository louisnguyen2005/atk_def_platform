<section class="section">
  <div class="container auth-wrap">
    <div class="card auth-card auth-card--split">
      <h1><%= t('auth.loginTitle') %></h1>
      <p class="muted"><%= t('auth.loginIntro') %></p>

      <div class="auth-split">
        <div class="auth-pane">
          <p class="auth-pane-kicker mono"><%= t('auth.captainKicker') %></p>
          <h2 class="auth-pane-title"><%= t('auth.captainTitle') %></h2>
          <%- include('../partials/errors') %>
          <form action="/login" method="post" class="form" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="next" value="<%= next %>">
            <label>
              <span><%= t('auth.email') %></span>
              <input type="email" name="email" value="<%= email %>" required autocomplete="email" <%= tokenErrors.length ? '' : 'autofocus' %>>
            </label>
            <label>
              <span><%= t('auth.password') %></span>
              <input type="password" name="password" required autocomplete="current-password">
            </label>
            <button type="submit" class="btn btn-primary btn-block"><%= t('auth.submitLogin') %></button>
          </form>
          <p class="muted auth-foot"><%= t('auth.noAccount') %> <a href="/register"><%= t('nav.register') %></a></p>
        </div>

        <div class="auth-pane auth-pane--token">
          <p class="auth-pane-kicker mono"><%= t('auth.memberKicker') %></p>
          <h2 class="auth-pane-title"><%= t('auth.memberTitle') %></h2>
          <% if (tokenErrors.length) { %>
            <div class="alert alert-error" role="alert"><ul><% tokenErrors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
          <% } %>
          <form action="/login/token" method="post" class="form" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="next" value="<%= next %>">
            <label>
              <span><%= t('auth.teamToken') %></span>
              <input type="text" name="token" class="token-input" required autocomplete="off" spellcheck="false"
                     maxlength="16" pattern="[0-9a-fA-F]{16}" placeholder="<%= t('auth.tokenPlaceholder') %>" <%= tokenErrors.length ? 'autofocus' : '' %>>
            </label>
            <button type="submit" class="btn btn-outline btn-block"><%= t('auth.submitToken') %></button>
          </form>
          <p class="muted auth-foot"><%= t('auth.tokenHint') %></p>
        </div>
      </div>
    </div>
  </div>
</section>
